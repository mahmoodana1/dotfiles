-- Copied to ~/.config/hypr/lua/colors.lua on a fresh install.
--
-- The real file is generated by wallust from the current wallpaper, so it is
-- gitignored (it would otherwise change on every theme switch). This template
-- exists only so the config parses on a machine where wallust has not run yet
-- — without it, `require("colors")` fails and Hyprland refuses to start.
--
-- It is overwritten the moment you pick a wallpaper (SUPER+W). The generating
-- template lives at wallust/.config/wallust/templates/colors-hyprland.lua.
--
-- Every key below must stay present: lua/decorations.lua and lua/windowrules.lua
-- index them by name, and a nil lookup is a hard config error.

return {
    background = "rgb(11121D)",
    foreground = "rgb(C8D3F5)",
    color0     = "rgb(11121D)",
    color1     = "rgb(FF757F)",
    color2     = "rgb(C3E88D)",
    color3     = "rgb(FFC777)",
    color4     = "rgb(82AAFF)",
    color5     = "rgb(C099FF)",
    color6     = "rgb(86E1FC)",
    color7     = "rgb(C8D3F5)",
    color8     = "rgb(444A73)",
    color9     = "rgb(FF757F)",
    color10    = "rgb(C3E88D)",
    color11    = "rgb(FFC777)",
    color12    = "rgb(82AAFF)",
    color13    = "rgb(C099FF)",
    color14    = "rgb(86E1FC)",
    color15    = "rgb(C8D3F5)",
}
