-- Copied to ~/.config/hypr/lua/workspaces.lua on a fresh install, because
-- pinning workspaces to named outputs only makes sense on the machine those
-- outputs exist on. Regenerated by ~/.config/hypr/scripts/nwg-displays.sh.
--
-- Leaving this file with no rules is perfectly valid: workspaces then land on
-- whichever monitor is focused. Add rules only when you want them anchored.
--
-- Reference: https://wiki.hypr.land/Configuring/Workspace-Rules/

-- The authoring machine pins 1-8 to the external screen and keeps 9-10 on the
-- laptop panel, so the SUPER+T (ws 8) and SUPER+A (ws 5) TUI shortcuts always
-- open on the big display:
--
-- hl.workspace_rule({ workspace = "9",  monitor = "eDP-1" })
-- hl.workspace_rule({ workspace = "10", monitor = "eDP-1" })
-- hl.workspace_rule({ workspace = "1",  monitor = "HDMI-A-1" })
-- ...through...
-- hl.workspace_rule({ workspace = "8",  monitor = "HDMI-A-1" })
