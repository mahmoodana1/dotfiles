# Copy to ~/.config/secrets.env and fill in real values:
#
#     cp ~/dotfiles/templates/secrets.env.example ~/.config/secrets.env
#     chmod 600 ~/.config/secrets.env
#
# install.sh does this for you. The real file is gitignored and must never
# be committed. It is sourced by shell/.zshrc, which tolerates it being absent.
#
# Add machine-local tokens as `export NAME=value` lines.
