# Copy to ~/.config/secrets.env and fill in real values:
#
#     cp ~/dotfiles/templates/secrets.env.example ~/.config/secrets.env
#     chmod 600 ~/.config/secrets.env
#
# install.sh does this for you. The real file is gitignored and must never
# be committed. It is sourced by:
#   - shell/.zshrc                        (the `octui` alias)
#   - hypr/.config/hypr/scripts/openclaw-tui.sh (SUPER+A launcher)
#
# Both call sites tolerate the file being absent — you just get an empty
# token rather than a broken shell.

# OpenClaw API token. Obtain from your OpenClaw instance.
export OPENCLAW_TOKEN=replace-me
