// ### Peek ### minimal auto-hiding bar
// Hidden; visible only while SUPER is physically held.
// Driven by ~/.config/hypr/scripts/WaybarPeek.py.
// "name" also sets the layer namespace to "peek" (blur rule in hypr/lua/peek.lua).
// Switch on/off (restores your previous layout+style): SUPER+SHIFT+B

{
"name": "peek",
"layer": "overlay",
"position": "top",
"exclusive": false,
"passthrough": false,
"start_hidden": true,
"height": 26,
"margin-top": 6,
"margin-left": 12,
"margin-right": 12,
"fixed-center": true,
"reload_style_on_change": true,

"modules-left": [
	"hyprland/workspaces#peek",
	],
"modules-center": [
	"clock#peek",
	],
"modules-right": [
	"network#peek",
	"pulseaudio#peek",
	"battery#peek",
	"group/peek-info",
	],

// Workspaces: occupied ones only, active one bright
"hyprland/workspaces#peek": {
	"format": "{id}",
	"show-special": false,
	"sort-by-number": true,
	"on-click": "activate",
	},

// Clock: time only; click for the date, hover for the calendar
"clock#peek": {
	"format": "{:%H:%M}",
	"format-alt": "{:%a %d %b  %H:%M}",
	"tooltip-format": "<tt>{calendar}</tt>",
	"calendar": {
		"mode": "month",
		"format": { "today": "<b><u>{}</u></b>" },
		},
	},

// ---- Alert-only icons: empty text hides the module ----
"network#peek": {
	"format-wifi": "",
	"format-ethernet": "",
	"format-linked": "",
	"format-disconnected": "󰤮 offline",
	"tooltip-format-disconnected": "No network",
	},
"pulseaudio#peek": {
	"format": "",
	"format-muted": "󰝟",
	"tooltip-format": "Muted — click to unmute",
	"on-click": "$HOME/.config/hypr/scripts/Volume.sh --toggle",
	},
"battery#peek": {
	"states": { "warning": 20, "critical": 10 },
	"format": "",
	"format-warning": "{icon} {capacity}%",
	"format-critical": "{icon} {capacity}%",
	"format-charging": "",
	"format-plugged": "",
	"format-full": "",
	"format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽"],
	},

// ---- Info drawer: a single dot; hover to slide out the details ----
"group/peek-info": {
	"orientation": "horizontal",
	"drawer": {
		"transition-duration": 250,
		"children-class": "peek-child",
		"transition-left-to-right": false,
		},
	"modules": [
		"custom/peek-dot",
		"cpu#peek",
		"memory#peek",
		"temperature#peek",
		"disk#peek",
		"battery#peek-info",
		"pulseaudio#peek-info",
		],
	},
"custom/peek-dot": {
	"exec": "echo ",
	"interval": "once",
	"format": "{}",
	"tooltip": false,
	},
"cpu#peek": {
	"interval": 5,
	"format": " {usage}%",
	},
"memory#peek": {
	"interval": 10,
	"format": "󰍛 {percentage}%",
	"tooltip-format": "{used:0.1f} / {total:0.1f} GiB",
	},
"temperature#peek": {
	"interval": 10,
	"critical-threshold": 85,
	"format": " {temperatureC}°",
	},
"disk#peek": {
	"interval": 60,
	"path": "/",
	"format": " {percentage_used}%",
	},
"battery#peek-info": {
	"format": "{icon} {capacity}%",
	"format-charging": "󰂄 {capacity}%",
	"format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
	},
"pulseaudio#peek-info": {
	"format": "{icon} {volume}%",
	"format-muted": "󰝟 {volume}%",
	"format-icons": { "default": ["", "", ""] },
	"on-click": "$HOME/.config/hypr/scripts/Volume.sh --toggle",
	"on-scroll-up": "$HOME/.config/hypr/scripts/Volume.sh --inc",
	"on-scroll-down": "$HOME/.config/hypr/scripts/Volume.sh --dec",
	},
}
