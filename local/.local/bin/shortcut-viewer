#!/usr/bin/env bash
# shortcut-viewer: two-step fuzzy picker over ~/dotfiles/shortcuts.md.
#   1. Pick a category (## section), or "All shortcuts"
#   2. Pick a shortcut inside that category
#   3. Detail popup on Enter (breadcrumb + keys + action + section prose)

MD="$HOME/dotfiles/shortcuts.md"
KB_THEME="$HOME/.config/rofi/config-keybinds.rasi"

if [[ ! -f "$MD" ]]; then
    notify-send -u critical "shortcut-viewer" "shortcuts.md not found at $MD"
    exit 1
fi

pidof rofi >/dev/null && pkill rofi

# ---------------------------------------------------------------------------
# Parse into TSV: section \t subsection \t keys \t action \t section_notes
# ---------------------------------------------------------------------------
parsed=$(awk -v FS='|' '
    BEGIN {
        section=""; subsection=""; in_code=0;
        section_notes=""; note_buf=""; capturing=0;
    }

    function finalize_notes() {
        if (capturing && note_buf != "") { section_notes = note_buf }
        capturing = 0; note_buf = ""
    }

    /^```/         { in_code = !in_code; next }
    in_code        { next }

    /^## /         {
        s=$0; sub(/^## +/,"",s);
        section=s; subsection="";
        section_notes=""; note_buf=""; capturing=1;
        next
    }
    /^### /        {
        finalize_notes();
        s=$0; sub(/^### +/,"",s); subsection=s;
        next
    }
    /^\|.*\|.*\|/  {
        finalize_notes();
        if ($0 ~ /^\|[- :|]+\|[[:space:]]*$/) next
        keys=$2; action=$3
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", keys)
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", action)
        low=tolower(keys)
        if (low == "keys" || low == "key" || low == "shortcut") next
        gsub(/`/, "", keys)
        if (keys == "" || action == "") next
        printf "%s\t%s\t%s\t%s\t%s\n", section, subsection, keys, action, section_notes
        next
    }
    /^---+$/       { finalize_notes(); next }
    /^$/           { if (note_buf != "") finalize_notes(); next }
    {
        if (capturing) {
            note_buf = (note_buf == "" ? $0 : note_buf " " $0)
        }
    }
' "$MD")

if [[ -z "$parsed" ]]; then
    notify-send "shortcut-viewer" "No shortcut rows found in shortcuts.md"
    exit 1
fi

ALL_LABEL="🌐  All shortcuts"

# ---------------------------------------------------------------------------
# STEP 1: category picker
# Build "  section   (N)" rows preserving first-seen order.
# ---------------------------------------------------------------------------
categories=$(echo "$parsed" | awk -F'\t' '
    !seen[$1]++ { order[++n]=$1 }
    { count[$1]++ }
    END { for (i=1; i<=n; i++) printf "%s\t%d\n", order[i], count[order[i]] }
')

# Prepend the "All" entry
cat_display=$(
    printf '%s\n' "$ALL_LABEL"
    echo "$categories" | awk -F'\t' '{ printf "  %-38s (%d)\n", $1, $2 }'
)

chosen_cat=$(echo "$cat_display" | rofi -dmenu -i \
    -p "category » " \
    ${KB_THEME:+-theme "$KB_THEME"} \
    -theme-str 'listview { lines: 12; }')

[[ -z "$chosen_cat" ]] && exit 0

# ---------------------------------------------------------------------------
# STEP 2: shortcut picker (filtered by chosen category, unless "All")
# ---------------------------------------------------------------------------
if [[ "$chosen_cat" == "$ALL_LABEL" ]]; then
    filtered="$parsed"
    prompt="shortcut » "
else
    # Extract just the section name from "  <section>   (N)"
    section_only=$(echo "$chosen_cat" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+\([0-9]+\)[[:space:]]*$//')
    filtered=$(echo "$parsed" | awk -F'\t' -v s="$section_only" '$1 == s')
    prompt="${section_only} » "
fi

display=$(echo "$filtered" | awk -F'\t' '{
    label = ($2 != "") ? "[" $2 "]" : ""
    printf "%-28s  %-30s  %s\n", label, $3, $4
}')

idx=$(echo "$display" | rofi -dmenu -i \
    -p "$prompt" \
    -format i \
    ${KB_THEME:+-theme "$KB_THEME"})

[[ -z "$idx" ]] && exit 0

row=$(echo "$filtered" | sed -n "$((idx+1))p")
[[ -z "$row" ]] && exit 0

IFS=$'\t' read -r section subsection keys action notes <<< "$row"

# ---------------------------------------------------------------------------
# STEP 3: detail popup
# ---------------------------------------------------------------------------
crumb="$section"
[[ -n "$subsection" ]] && crumb="$section  »  $subsection"

message="$crumb

  Keys     $keys
  Action   $action"

if [[ -n "$notes" ]]; then
    message="$message

$notes"
fi

rofi -e "$message" ${KB_THEME:+-theme "$KB_THEME"} \
    -theme-str 'window { width: 52em; }'
