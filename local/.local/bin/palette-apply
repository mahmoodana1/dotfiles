#!/usr/bin/env python3
"""Render ~/.config/palette/templates/* from palette.conf, then reload apps.

Template syntax (same as wallust, so templates are easy to write):
    {{accent}}          -> #64859F
    {{accent | strip}}  -> 64859F
    {{accent | rgb}}    -> 100,133,159

Where each template renders to is listed in ~/.config/palette/targets.
To theme a new app: drop a template in templates/, add one line to targets.
"""
import os
import re
import subprocess
import sys

DIR = os.path.expanduser("~/.config/palette")


def read_pairs(path):
    """Yield (key, value) from 'key = value' or 'key value' lines; '#' starts a comment line."""
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            key, _, val = line.partition("=") if "=" in line else line.partition(" ")
            yield key.strip(), val.split()[0]  # first word only: trailing notes are ignored


def load_palette():
    raw = {k: v for k, v in read_pairs(os.path.join(DIR, "palette.conf"))}
    colors = {}
    for key in raw:
        seen, val = {key}, raw[key]
        while not val.startswith("#"):  # follow aliases like  accent = color13
            if val not in raw or val in seen:
                sys.exit(f"palette.conf: '{key}' points at unknown or circular '{val}'")
            seen.add(val)
            val = raw[val]
        if not re.fullmatch(r"#[0-9A-Fa-f]{6}", val):
            sys.exit(f"palette.conf: '{key}' is not #RRGGBB: {val}")
        colors[key] = val.upper()
    return colors


def render(text, colors, name):
    def sub(m):
        key, filt = m.group(1), m.group(2)
        if key not in colors:
            sys.exit(f"templates/{name}: unknown color '{key}'")
        hexv = colors[key]
        if filt == "strip":
            return hexv[1:]
        if filt == "rgb":
            return ",".join(str(int(hexv[i:i + 2], 16)) for i in (1, 3, 5))
        return hexv

    return re.sub(r"\{\{\s*(\w+)\s*(?:\|\s*(\w+)\s*)?\}\}", sub, text)


def main():
    colors = load_palette()
    for tmpl, target in read_pairs(os.path.join(DIR, "targets")):
        with open(os.path.join(DIR, "templates", tmpl)) as f:
            out = render(f.read(), colors, tmpl)
        target = os.path.expanduser(target)
        os.makedirs(os.path.dirname(target), exist_ok=True)
        with open(target, "w") as f:
            f.write(out)
        print(f"  {tmpl} -> {target}")

    # Reload whatever is running so the new colors show up right away.
    quiet = {"stdout": subprocess.DEVNULL, "stderr": subprocess.DEVNULL}
    if os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        subprocess.run(["hyprctl", "reload"], **quiet)
    subprocess.run(["swaync-client", "--reload-css"], **quiet)
    subprocess.run(["pkill", "-SIGUSR2", "-x", "waybar"], **quiet)


if __name__ == "__main__":
    main()
