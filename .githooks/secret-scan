#!/usr/bin/env python3
"""Refuse a commit/push that carries secrets. This repo is PUBLIC.

  secret-scan staged          the index (pre-commit)
  secret-scan range A..B      commits about to be pushed (pre-push)
  secret-scan all             every commit on every branch (audit)

Checks the added lines of the diff for token shapes and the file names for
things that never belong here (keys, .env, browser logins, ...). Runs
gitleaks on top when it is installed. Hooks are wired by install.sh:
    git config core.hooksPath .githooks
A false positive: put  secret-scan:allow  on that line.
"""
import re, shutil, subprocess, sys

ALLOW = "secret-scan:allow"

LINE = {
    "GitHub token":       r"gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}",
    "API key (sk-...)":   r"\bsk-(ant-|proj-)?[A-Za-z0-9_-]{24,}",
    "AWS access key":     r"\b(AKIA|ASIA)[0-9A-Z]{16}\b",
    "Google API key":     r"\bAIza[0-9A-Za-z_-]{35}",
    "Slack token":        r"\bxox[baprs]-[A-Za-z0-9-]{10,}",
    "private key":        r"-----BEGIN [A-Z ]*PRIVATE KEY",
    "Tailscale key":      r"\btskey-[a-z]+-[A-Za-z0-9]{10,}",
    "JWT":                r"\beyJ[A-Za-z0-9_-]{20,}\.eyJ[A-Za-z0-9_-]{20,}",
    "Telegram bot token": r"\b[0-9]{8,10}:AA[A-Za-z0-9_-]{30,}",
    "URL with password":  r"[a-z][a-z0-9+.-]*://[^/\s:@]+:[^/\s:@]{6,}@",
    # token = "abc..." with a literal value (not $VAR, not a placeholder)
    "hardcoded secret":   r"(?i)\b[a-z_]*(token|secret|passw(or)?d|api[_-]?key|psk)[a-z_]*\s*[=:]\s*[\"']?(?!replace|example|your|changeme|xxx)[A-Za-z0-9+/_\-]{20,}",
}
LINE = {k: re.compile(v) for k, v in LINE.items()}

NAME = re.compile(
    r"(^|/)(secrets?\.env|\.env(\..*)?|\.netrc|\.git-credentials|\.pgpass|id_(rsa|dsa|ecdsa|ed25519)[^/]*"
    r"|logins\.json|key[34]\.db|cookies\.sqlite|places\.sqlite|hosts\.yml|[^/]*\.nmconnection"
    r"|[^/]*\.(pem|key|p12|pfx|kdbx|gpg|asc|token)|[^/]*credentials[^/]*|[^/]*_history)$"
    r"|(^|/)(\.ssh|\.gnupg|\.password-store)/",
    re.I)
NAME_OK = re.compile(r"\.example$")


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True, errors="replace").stdout


def scan(diff):
    found, path, line_no = [], "?", 0
    for line in diff.splitlines():
        if line.startswith("+++ "):
            path = line[6:] if line.startswith("+++ b/") else path
            if line != "+++ /dev/null" and NAME.search(path) and not NAME_OK.search(path):
                found.append((path, 0, "file that must not be tracked", ""))
        elif line.startswith("@@"):
            m = re.search(r"\+(\d+)", line)
            line_no = int(m.group(1)) - 1 if m else 0
        elif line.startswith("+"):
            line_no += 1
            if ALLOW in line or path.startswith(".githooks/"):
                continue
            for what, rx in LINE.items():
                m = rx.search(line)
                if m:
                    s = m.group(0)
                    found.append((path, line_no, what, s[:6] + "…" + s[-2:]))
        elif not line.startswith("-"):
            line_no += 1
    return found


def main():
    mode = sys.argv[1] if len(sys.argv) > 1 else "staged"
    if mode == "staged":
        diff, leaks = git("diff", "--cached", "-U0", "--no-color", "--diff-filter=ACMR"), ["protect", "--staged"]
    elif mode == "range":
        rng = sys.argv[2:]
        diff, leaks = git("log", "-p", "-U0", "--no-color", *rng), ["detect", "--log-opts", " ".join(rng)]
    else:
        diff, leaks = git("log", "--all", "-p", "-U0", "--no-color"), ["detect"]

    found = scan(diff)
    for path, n, what, shown in found:
        print(f"  ✗ {path}{':' + str(n) if n else ''}  {what}  {shown}", file=sys.stderr)

    bad = bool(found)
    if shutil.which("gitleaks"):
        bad |= subprocess.run(["gitleaks", *leaks, "--no-banner", "--redact"]).returncode != 0

    if bad:
        print(f"\nsecret-scan: blocked — this repo is public. Remove it (or mark a false\n"
              f"positive with `{ALLOW}` on that line) and try again.", file=sys.stderr)
        return 1
    return 0


sys.exit(main())
