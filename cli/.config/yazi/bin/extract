#!/usr/bin/env bash
# Extract each archive into the current dir, asking before overwriting. Prefers ouch, falls back to unrar/7z/bsdtar.
for f in "$@"; do
  if command -v ouch >/dev/null; then ouch decompress -- "$f" && continue; fi
  case "${f,,}" in
    *.rar) unrar x -- "$f" ;;
    *.tar|*.tar.*|*.tgz|*.tbz2|*.txz) bsdtar -xkf "$f" ;;
    *) 7z x -- "$f" ;;
  esac || { echo "Failed: $f"; read -rp "Press Enter"; }
done
