/*
 * config-keybinds.rasi
 * Rofi config for the shortcut viewer (~/.local/bin/shortcut-viewer).
 * Inherits colors/typography from modern-mocha via config.rasi.
 */

@import "~/.config/rofi/config.rasi"

entry {
    expand:      true;
    placeholder: "search shortcuts…";
}

listview {
    columns:      1;
    lines:        22;
    fixed-height: false;
    scrollbar:    true;
    spacing:      2px;
    cycle:        true;
}

window {
    width:  64em;
    height: inherit;
}

element {
    orientation: horizontal;
    padding:     6px 12px;
}

element-icon {
    size: 0%;
}

element-text {
    horizontal-align: 0.0;
    vertical-align:   0.5;
    margin:           0;
    padding:          0;
}
