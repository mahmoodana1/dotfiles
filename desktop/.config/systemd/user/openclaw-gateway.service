[Unit]
Description=OpenClaw Gateway (v2026.6.11)
After=network-online.target
Wants=network-online.target
StartLimitBurst=5
StartLimitIntervalSec=60
# On demand: started by openclaw.service (openclaw.socket, port 18789) and
# stopped once that proxy exits idle. Not enabled on its own.
StopWhenUnneeded=yes

[Service]
ExecStart=%h/.config/nvm/versions/node/v22.22.0/bin/node %h/.config/nvm/versions/node/v22.22.0/lib/node_modules/openclaw/dist/index.js gateway --port 18790 --bind loopback
# ready = listening, so the proxy's first connection isn't refused
ExecStartPost=/usr/bin/bash -c 'for i in {1..280}; do (: </dev/tcp/127.0.0.1/18790) 2>/dev/null && exit 0; sleep 0.1; done; exit 1'
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78
TimeoutStopSec=30
TimeoutStartSec=30
SuccessExitStatus=0 143
OOMPolicy=continue
KillMode=control-group
Environment=HOME=%h
Environment=TMPDIR=/tmp
Environment=NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
Environment=PATH=%h/.config/nvm/versions/node/v22.22.0/bin:%h/.bun/bin:%h/.config/nvm/current/bin:%h/.local/bin:%h/.npm-global/bin:%h/bin:%h/.nix-profile/bin:%h/.nvm/current/bin:%h/.local/share/pnpm:/usr/local/bin:/usr/bin:/bin
Environment=OPENCLAW_GATEWAY_PORT=18790
Environment=OPENCLAW_SYSTEMD_UNIT=openclaw-gateway.service
Environment="OPENCLAW_WINDOWS_TASK_NAME=OpenClaw Gateway"
Environment=OPENCLAW_WINDOWS_TASK_HIDDEN_LAUNCHER=1
Environment=OPENCLAW_SERVICE_MARKER=openclaw
Environment=OPENCLAW_SERVICE_KIND=gateway
Environment=OPENCLAW_SERVICE_VERSION=2026.6.11
