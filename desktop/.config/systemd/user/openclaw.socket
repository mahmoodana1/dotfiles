[Unit]
Description=OpenClaw Gateway socket (starts the gateway on first connection)

# The gateway only runs while something talks to it: the first connection to
# 18789 starts openclaw.service (a proxy), which pulls in the gateway on 18790.
# Loopback only: behind the proxy every client looks local to the gateway.
[Socket]
ListenStream=127.0.0.1:18789

[Install]
WantedBy=sockets.target
